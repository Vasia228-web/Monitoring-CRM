[Unit]
Description=Realty: щоденний бекап бази

[Service]
Type=oneshot
WorkingDirectory=%h/realty
EnvironmentFile=-%h/realty/.env
Environment=PYTHONUNBUFFERED=1
ExecStart=%h/realty/.venv/bin/python cli.py backup --if-due
TimeoutStartSec=20min
Nice=10
# Службові й нічні задачі теж поступаються сайту (Блок 2, D50; без root).
CPUWeight=20
IOSchedulingClass=best-effort
IOSchedulingPriority=7

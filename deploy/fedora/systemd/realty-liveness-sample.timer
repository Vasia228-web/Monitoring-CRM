[Unit]
Description=Realty: контрольна вибірка щосереди о 10:20 (між циклами 09:05 і 12:05)

[Timer]
# Цикли — 00:05, 03:05, …, 21:05, тривають 45–60 хв (крок «дублі» — до ~15 хв): о 10:20
# цикл 09:05 уже скінчився, до 12:05 — 1 год 45 хв. Перший запуск — 14.10.2026.
OnCalendar=Wed *-*-* 10:20:00
# Пропущений запуск (машина спала) не наздоганяємо: удень він перетнувся б із циклом.
Persistent=false

[Install]
WantedBy=timers.target

[Unit]
Description=Realty: сигнал тиші й інші тривоги в Telegram
# Сторож сам упав (виняток, TimeoutStartSec) — критична тривога одразу окремим шляхом
# (realty-alert@ → cli.py alert unit-failed; рецензія W3, 08.10): інакше сторож, що
# падає, мовчав би про все, включно з власним падінням.
OnFailure=realty-alert@%n.service

[Service]
Type=oneshot
WorkingDirectory=%h/realty
EnvironmentFile=-%h/realty/.env
Environment=PYTHONUNBUFFERED=1
ExecStart=%h/realty/.venv/bin/python cli.py watchdog
TimeoutStartSec=5min

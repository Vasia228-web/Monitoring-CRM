[Unit]
Description=Realty: веб-інтерфейс (лише localhost; назовні — через тунель)
# Упала (failed) — критична тривога одразу (realty-alert@, хвиля W3, D58). Restart=always
# цього НЕ скасовує: за RestartMode=normal (типово, systemd ≥ 254) служба при кожному
# падінні проходить через стан failed і OnFailure спрацьовує, а вже потім — перезапуск
# (лише RestartMode=direct пропускає failed і OnFailure). Тож кожне падіння — тривога;
# шквал падінь `cli.py alert unit-failed` стримує сам (раз на 60 хв на службу, далі —
# лічильник). Сайт, що після перезапуску так і не піднявся, ще й ловить сторож
# (site-local, 2 запуски поспіль). Рецензія W3, 08.10: попередній коментар казав, що
# до failed служба «зазвичай не доходить» — це неправда.
OnFailure=realty-alert@%n.service
StartLimitIntervalSec=0

[Service]
WorkingDirectory=%h/realty
EnvironmentFile=-%h/realty/.env
Environment=PYTHONUNBUFFERED=1
ExecStart=%h/realty/.venv/bin/python cli.py serve --host 127.0.0.1 --port 8000
Restart=always
RestartSec=5
# --- Пріоритет сайту над збором (Блок 2, крок E5, D50) ---------------------------
# Лише те, що діє в користувацькому менеджері systemd БЕЗ root:
#  * CPUWeight — частка процесора серед служб користувача (цикл: 20). Діє, якщо
#    контролер cpu делеговано user@.service (у systemd ≥252 — типово:
#    Delegate=pids memory cpu); інакше systemd тихо його не застосує. Перевірка —
#    `cli.py speed priorities` (cpu.weight у cgroup служби).
#  * IOSchedulingClass/Priority — пріоритет диска процесу (ionice). Клас
#    best-effort із будь-яким рівнем 0–7 ядро дозволяє без прав (лише realtime
#    вимагає CAP_SYS_ADMIN); діє з планувальником BFQ (HDD на Fedora — типово).
# Чого тут НЕМАЄ, бо без root не діє: IOWeight (контролер io не делеговано
# користувачу), MemoryLow (захист пам'яті потребує memory.low і в батьківських
# групах), від'ємні Nice/OOMScoreAdjust. Це — дія власника через sudo (D50).
CPUWeight=1000
IOSchedulingClass=best-effort
IOSchedulingPriority=0

[Install]
WantedBy=default.target

[Unit]
Description=Realty: регулярний цикл збору й обслуговування
# Ліміт запусків systemd рахує ВСІ старти — і за таймером, і ручні, а не лише
# перезапуски після падіння. Перша версія (3 за 6 год) 21.09.2026 відхилила
# ручний перевірочний цикл після двох планових і одного ручного — і так само
# могла б відхилити плановий. 12 за 6 год: таймер дає 2, решта — запас на
# ручні запуски й перезапуски; зациклення падінь стримує RestartSec=10min.
StartLimitIntervalSec=6h
StartLimitBurst=12

[Service]
Type=oneshot
WorkingDirectory=%h/realty
EnvironmentFile=-%h/realty/.env
Environment=PYTHONUNBUFFERED=1
ExecStart=%h/realty/.venv/bin/python cli.py cycle --trigger schedule
# Другий шар поверх RUN_TIMEOUT (2 год) у коді: якщо навіть диригент завис,
# systemd вб'є всю групу процесів, включно з браузером.
TimeoutStartSec=2h20min
KillMode=control-group
Restart=on-failure
RestartSec=10min
Nice=5
# 3,7 ГБ на всю машину: Chromium не має витіснити решту системи.
MemoryHigh=1800M
MemoryMax=2600M

[Unit]
Description=Realty: нічні вікна 01:10 і 04:10 між циклами (замість realty-identity.timer)

[Timer]
# Не 01:00 і 04:00: цикл, що стартує о 00:05 і 03:05, триває близько 55 хв і
# накладався б на початок вікна (диригент однаково чекає замка, config/night.toml).
OnCalendar=*-*-* 01,04:10:00
# Пропущене вікно (машина спала) не наздоганяємо: удень воно перетнулося б із циклом.
Persistent=false

[Install]
WantedBy=timers.target

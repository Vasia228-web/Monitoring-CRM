[Unit]
Description=Realty: нічний дозбір сильних ознак квартир (не паралельно зі збором)

[Service]
Type=oneshot
WorkingDirectory=%h/realty
EnvironmentFile=-%h/realty/.env
Environment=PYTHONUNBUFFERED=1
# Той самий замок, що й у циклу: якщо цикл ще йде — вікно пропускається.
# 110 хв: старт о 01:00 і 04:00 → кінець до циклів о 03:05 і 06:05.
ExecStart=%h/realty/.venv/bin/python cli.py identity backfill --budget-min 110
TimeoutStartSec=2h
Nice=10
MemoryHigh=1800M
MemoryMax=2600M

# --- LLM-фолбек ---------------------------------------------------------------
# Резервний рівень: викликається, ЛИШЕ коли парсер не дістав ціну, кімнати або
# площу. У звичайному прогоні кількість викликів дорівнює нулю.
ANTHROPIC_API_KEY=
LLM_FALLBACK=1
# Найдешевша й найшвидша модель ($1/$5 за млн токенів). Дорожчі моделі
# (Sonnet/Opus) для парсингу не використовуються.
LLM_MODEL=claude-haiku-4-5
LLM_MAX_CALLS=25          # стеля викликів на один прогін
LLM_MAX_CHARS=2500        # стеля очищеного тексту в одному запиті

# --- Мережа -------------------------------------------------------------------
REQUEST_DELAY=1.2
HTTP_TIMEOUT=30
HTTP_RETRIES=3
CACHE_TTL=3600
# PROXY_URL=http://user:pass@host:port

# --- Дані ---------------------------------------------------------------------
# DB_URL=sqlite:///data/realty.db
# SOURCES=domria,lun,olx,flombu,blago
# USD_UAH_RATE=42.0

# --- Доступ до інтерфейсу -------------------------------------------------------
# Власник: усе, включно з /status, запуском збору й блокуваннями входу.
# ОБОВ'ЯЗКОВО для доступу ззовні: без цих двох тунель не піднімається.
AUTH_USER=
AUTH_PASSWORD=
# Друг: перегляд, аналітика, «в обробці» (список спільний); без /status.
# Порожні — входу для друга немає. Логін не має збігатися з AUTH_USER.
FRIEND_USER=
FRIEND_PASSWORD=

# --- Ліміти часу (секунди) ------------------------------------------------------
# REQUEST_TIMEOUT=45        # один зовнішній запит, від першого до останнього байта
# BROWSER_OP_TIMEOUT=120    # одна операція браузера; більше — браузер вбивається
# SOURCE_TIMEOUT=1800       # одне джерело в циклі; SOURCE_TIMEOUT_OLX=… — окремо
# RUN_TIMEOUT=7200          # увесь цикл

# --- Сигнали й бекапи -----------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# ALERT_SILENCE_HOURS=7     # скільки годин без успішного збору — вже тривога
# ALERT_REPEAT_HOURS=6      # повтор тієї ж тривоги не частіше
# BACKUP_KEEP=7             # скільки архівів тримати локально
# BACKUP_REMOTE=user@host:realty-backups   # додаткова копія через scp
# BACKUP_TELEGRAM=1         # архів у Telegram (тимчасово: бот не бере файли > 50 МБ)
# Копія в хмару через rclone. Доступ до акаунта дає людина одноразово:
#   rclone config create gdrive drive scope=drive.file
# (scope=drive.file — rclone бачить лише ті файли, які сам створив)
# BACKUP_RCLONE_REMOTE=gdrive:realty-backups

# --- Доступ ззовні (Cloudflare Tunnel) ------------------------------------------
# Порожньо — тимчасова адреса *.trycloudflare.com (міняється після перезапуску,
# нова приходить у Telegram). Коли буде домен: вписати обидва значення й
# перезапустити службу: systemctl --user restart realty-tunnel
PUBLIC_DOMAIN=
CLOUDFLARE_TUNNEL_TOKEN=
